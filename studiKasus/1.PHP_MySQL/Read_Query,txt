<?php 

/* 

ALUR LOGIKA FUNCTION QUERY 

[Start]
   ↓
Panggil function query($query)
   ↓
Ambil koneksi (global $koneksi)
   ↓
Jalankan mysqli_query($koneksi, $query)
   ↓
Apakah query berhasil?
   ├── Tidak → (error / false) → [End]
   ↓ Ya
Inisialisasi $rows = []
   ↓
Ambil 1 baris data (mysqli_fetch_assoc)
   ↓
Apakah masih ada data?
   ├── Ya → masukkan ke $rows[] → ulangi ambil data
   └── Tidak
   ↓
Return $rows
   ↓
Disimpan ke $books
   ↓
[End]


INGAT DALAM OPERASI CRUD~CREATE, READ, UPDATE, DELETE DALAM MySQL/MARIADB
QUERY TERMASUK PADA READ

ADA BANYAK METODA QUERY DATA DARI TABEL DALAM DATABASE
CARA YAANG SAYA GUNAKAN ADALAH SALAH SATUNNYA, TETAPI SECARA UMUM ALURNYA SAMA

*/

// Koneksi Database
$koneksi = mysqli_connect("localhost", "root", "rahasia_dong", "buku");

function query($query)
{
    // Koneksi database dan menglobalkan $koneksi ~ ingat variable scope
    global $koneksi;

    $result = mysqli_query($koneksi, $query);

    // membuat varibale array
    $rows = [];

    // mengambil semua data dalam bentuk array
    while ($row = mysqli_fetch_assoc($result)) {
        $rows[] = $row;
    }

    return $rows;
}


$books = query("SELECT * FROM list_buku ORDER BY id DESC");


