<?php if(!isset($_POST["Nama"]) || !isset( $_POST["NIM"]) || !isset($_POST["Prodi"]) ){

	header('location: 5.refreshPHP_5.php');
	exit;
} 	
 ?>

 <!DOCTYPE html>
 <html>
 <head>
 	<title>MetodaReqPOST</title>
 </head>
 <body>
 
<h3>Detail Data Murid</h3>
<p>Halaman ini menangkap data yang dikirmkan dengan metoda post dari form dan ditangkap dengan superglobal $_POST</p>
<br>
<ul>
	<li>NAMA     : <?=$_POST['Nama']; ?></li>
	<li>NIM      : <?= $_POST['NIM']; ?></li>
	<li>Prodi    : <?= $_POST['Prodi']; ?></li>
</ul>
<p><a href="5.refreshPHP_5.php">Kembali</a></p>
 </body>
 </html>

 <?php /*

Terlihat perbedaan metoda request get dan post dalam mengirim data
jika post, setelah tombol kirim pada halaman '5.refreshPHP_5.php' ditekan
tidak ada data pada address bar / url
 

 */ ?>
